# Usado pelo docker-compose.yml da raiz.
# Copie para .env antes de rodar `docker compose up -d`.

POSTGRES_USER=cardapio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cardapio
POSTGRES_PORT=5432

BACKEND_PORT=3333

# Obrigatório, mínimo de 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
