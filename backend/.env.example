# Copie para .env e ajuste os valores.

NODE_ENV=development
PORT=3333

# ----------------------------------------------------------------- BANCO
# A aplicação só precisa de uma DATABASE_URL válida. Trocar de banco é trocar
# esta linha — nenhum arquivo de código muda.
#
# 1) Postgres local do Prisma (padrão para desenvolvimento, não exige Docker):
#      npm run db:dev        deixa rodando em outro terminal
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
#
# 2) PostgreSQL instalado na máquina:
# DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/cardapio?schema=public"
#
# 3) Neon (https://neon.tech) — copie a connection string do painel:
# DATABASE_URL="postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/cardapio?sslmode=require"
#
# 4) Supabase (https://supabase.com) — use a porta 6543 (pooler) e pgbouncer=true:
# DATABASE_URL="postgresql://postgres.xxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# ------------------------------------------------------------ SEGURANÇA
# Mínimo de 32 caracteres. Gere um novo para produção:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-de-48-bytes"
JWT_EXPIRES_IN=7d

# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# --------------------------------------------------------------- UPLOADS
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
