# Copie para .env e ajuste os valores.

NODE_ENV=development
PORT=3333

# Conexão do PostgreSQL. Com o docker-compose deste repositório, o host é
# "postgres" dentro da rede do Docker e "localhost" quando roda fora dele.
DATABASE_URL="postgresql://cardapio:cardapio@localhost:5432/cardapio?schema=public"

# Precisa ter no mínimo 32 caracteres. Gere um novo para produção:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-de-48-bytes"
JWT_EXPIRES_IN=7d

# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Uploads de imagens
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
